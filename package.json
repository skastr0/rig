    "@opentui/react": "^0.3.0",
    "effect": "3.21.0",
    "react": "^19.2.6"
  },
  "overrides": {
    "effect": "3.21.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.16.3",
    "@skastr0/pulsar-project-module-effect": "0.1.1",
    "@types/react": "^19.2.15",
    "bun-types": "^1.3.4",
    "oxfmt": "latest",
    "oxlint": "^1.28.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
