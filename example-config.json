{
  "items": [
    {
      "name": "homebrew",
      "profiles": ["work", "personal"],
      "tags": ["brew", "essential"],
      "check": "which brew",
      "install": "/bin/bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
    },
    {
      "name": "neovim",
      "profiles": ["work", "personal"],
      "tags": ["brew", "editor", "dev", "essential"],
      "check": "which nvim",
      "install": { "source": "brew", "formula": "neovim" },
      "update": "brew upgrade neovim",
      "group": "brew",
      "dependsOn": ["homebrew"]
    },
    {
      "name": "ripgrep",
      "profiles": ["work", "personal"],
      "tags": ["brew", "dev", "essential"],
      "check": "which rg",
      "install": { "source": "brew", "formula": "ripgrep" },
      "group": "brew",
      "dependsOn": ["homebrew"]
    },
    {
      "name": "fd",
      "profiles": ["work", "personal"],
      "tags": ["brew", "dev"],
      "check": "which fd",
      "install": { "source": "brew", "formula": "fd" },
      "group": "brew",
      "dependsOn": ["homebrew"]
    },
    {
      "name": "fzf",
      "profiles": ["work", "personal"],
      "tags": ["brew", "dev"],
      "check": "which fzf",
      "install": { "source": "brew", "formula": "fzf" },
      "group": "brew",
      "dependsOn": ["homebrew"]
    },
    {
      "name": "zoxide",
      "profiles": ["work", "personal"],
      "tags": ["brew", "shell", "dev"],
      "check": "which zoxide",
      "install": { "source": "brew", "formula": "zoxide" },
      "group": "brew",
      "dependsOn": ["homebrew"]
    },
    {
      "name": "nvim-config",
      "profiles": ["work", "personal"],
      "tags": ["editor", "config"],
      "check": "~/.config/nvim/init.lua",
      "onCheck": "path-exists",
      "install": {
        "source": "git",
        "repo": "https://github.com/username/nvim-config.git",
        "path": "~/.config/nvim"
      },
      "dependsOn": ["neovim"],
      "backup": "~/.config/nvim"
    },
    {
      "name": "mise",
      "profiles": ["work", "personal"],
      "tags": ["brew", "runtime", "dev"],
      "check": "which mise",
      "install": { "source": "brew", "formula": "mise" },
      "group": "brew",
      "dependsOn": ["homebrew"]
    },
    {
      "name": "nodejs",
      "profiles": ["work", "personal"],
      "tags": ["runtime", "node", "dev"],
      "check": "node --version | grep -q 24",
      "install": "mise use -g node@lts",
      "dependsOn": ["mise"]
    },
    {
      "name": "pnpm",
      "profiles": ["work", "personal"],
      "tags": ["runtime", "node", "dev"],
      "check": "which pnpm",
      "install": "mise use -g npm:pnpm@latest",
      "dependsOn": ["nodejs"]
    },
    {
      "name": "docker",
      "profiles": ["work"],
      "tags": ["brew", "containers", "devops"],
      "check": "docker info >/dev/null 2>&1",
      "install": { "source": "brew", "cask": "docker" },
      "group": "brew",
      "dependsOn": ["homebrew"]
    },
    {
      "name": "slack",
      "profiles": ["work"],
      "tags": ["brew", "communication", "work"],
      "check": "/Applications/Slack.app",
      "onCheck": "path-exists",
      "install": { "source": "brew", "cask": "slack" },
      "group": "brew",
      "dependsOn": ["homebrew"]
    },
    {
      "name": "work-tools",
      "profiles": ["work"],
      "tags": ["brew", "work"],
      "check": "which work-cli",
      "install": { "source": "brew", "formula": "work-cli" },
      "group": "brew",
      "dependsOn": ["homebrew"]
    },
    {
      "name": "personal-repos",
      "profiles": ["personal"],
      "tags": ["filesystem", "personal"],
      "install": { "source": "dir", "path": "~/Projects/personal" }
    },
    {
      "name": "steam",
      "profiles": ["personal"],
      "tags": ["brew", "gaming", "personal"],
      "check": "/Applications/Steam.app",
      "onCheck": "path-exists",
      "install": { "source": "brew", "cask": "steam" },
      "group": "brew",
      "dependsOn": ["homebrew"]
    }
  ]
}
